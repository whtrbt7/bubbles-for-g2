{
  "name": "bubbles-for-g2",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "sim": "evenhub-simulator http://localhost:5173 --automation-port 9898",
    "qr": "evenhub qr --port 5173",
    "typecheck": "tsc",
    "test": "vitest run",
    "build": "tsc && vite build",
    "pack": "npm run build && evenhub pack app.json ./dist -o bubbles-for-g2.ehpk",
    "smoke": "node scripts/sim-smoke.mjs shots"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
